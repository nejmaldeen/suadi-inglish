# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# generated build output (keep the Sites build plugin source)
/build/*
!/build/sites-vite-plugin.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment secrets
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/.wrangler/
/.sites-runtime/
/outputs/
/work/
